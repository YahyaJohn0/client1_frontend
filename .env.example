# Public browser configuration; these values are embedded in the frontend.
API_BASE_URL=http://localhost:8080
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID=

# Public browser settings for unsigned image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=zamzam
CLOUDINARY_URL=
CLOUDINARY_API_SECRET=

# FIRESTORE_URL and all other database credentials belong only in
# client_backend/.env or the backend host's secret manager.
