# Public browser configuration; values are embedded in the Vite bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=

# Node.js API runtime configuration; never prefix server values with VITE_.
NODE_ENV=production
PORT=3000
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_APP_ID=
ADMIN_UIDS=
ALLOW_LOCAL_ADMIN=false
CORS_ORIGINS=https://your-store.example.com
TRUST_PROXY=1
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
ZAMZAM_DATA_DIR=/var/data/zamzam
ZAMZAM_UPLOADS_DIR=/var/data/zamzam/uploads
