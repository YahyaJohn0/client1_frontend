{
  "rules": {
    "admins": {
      ".read": false,
      ".write": false
    },
    "demoProducts": {
      ".indexOn": ["isActive"],
      ".read": "(auth != null && root.child('admins').child(auth.uid).val() == true) || (query.orderByChild == 'isActive' && query.equalTo == true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() == true"
    },
    ".read": false,
    ".write": false
  }
}
